# Copia a .env y rellena. Nunca subas .env.
PORT=3000
HOST=127.0.0.1
# Correo que recibe las facturas. Con solo esto se usa FormSubmit.co (sin claves; un clic de activación la primera vez).
MAIL_TO=tu-correo@ejemplo.com
# URL pública de la web (FormSubmit exige un Origin); por defecto http://127.0.0.1:PORT
SITE_URL=
# SMTP (prioridad sobre FormSubmit; requiere SMTP_PASS). Sin MAIL_TO ni SMTP: ./outbox (desarrollo).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true y una «contraseña de aplicación».
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Detrás de un proxy inverso (Nginx, Caddy...) para leer la IP real
TRUST_PROXY=false
LIMITE_IP=5
LIMITE_GLOBAL=60
